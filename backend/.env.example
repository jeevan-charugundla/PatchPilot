# PatchPilot keeps provider credentials server-side.
# Add future integration settings here; never expose secrets to the browser.
PATCHPILOT_ENV=development
# Create a GitHub OAuth App with callback:
# http://127.0.0.1:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
DATABASE_URL=sqlite:///./patchpilot.db
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://127.0.0.1:8000
